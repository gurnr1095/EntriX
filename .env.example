ENV=dev
AUTH_MODE=dev
CLERK_JWKS_URL=
CLERK_ISSUER=
DATABASE_URL=postgresql+asyncpg://sportreg:sportreg@localhost:5433/sportreg
TEST_DATABASE_URL=postgresql+asyncpg://sportreg:sportreg@localhost:5433/sportreg_test
QR_SECRET=change-me-to-a-long-random-string
SMTP_HOST=localhost
SMTP_PORT=1025
MAIL_FROM=no-reply@sportreg.local
OUTBOX_POLL_SECONDS=2
OUTBOX_MAX_ATTEMPTS=8

# --- Free-tier deployment (see DEPLOY.md) ---
# EMAIL_BACKEND=smtp            # smtp (MailHog or a normal server) or brevo (HTTPS API)
# BREVO_API_KEY=                # only for EMAIL_BACKEND=brevo; never commit a real key
# RUN_WORKER_IN_API=false       # true: run the email worker inside the API process
# OUTBOX_IDLE_POLL_SECONDS=2    # longest idle sleep; free tier uses 3600
# RUN_MIGRATIONS_ON_START=false # container applies migrations before serving
